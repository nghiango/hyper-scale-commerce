{"uid": "hyperscale-local", "title": "HyperScale Local Delivery", "schemaVersion": 39, "version": 1, "refresh": "15s", "panels": [{"id": 1, "title": "Application targets", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8}, "targets": [{"expr": "up{job=\"applications\"}", "refId": "A"}]}, {"id": 2, "title": "HTTP requests/sec", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8}, "targets": [{"expr": "sum by (pod) (rate(http_server_requests_seconds_count[5m]))", "refId": "A"}]}, {"id": 3, "title": "HTTP p95 seconds", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le, pod) (rate(http_server_requests_seconds_bucket[5m])))", "refId": "A"}]}, {"id": 4, "title": "JVM memory bytes", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8}, "targets": [{"expr": "sum by (pod) (jvm_memory_used_bytes)", "refId": "A"}]}, {"id": 5, "title": "Process CPU fraction", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8}, "targets": [{"expr": "process_cpu_usage", "refId": "A"}]}, {"id": 6, "title": "Hikari active connections", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8}, "targets": [{"expr": "hikaricp_connections_active", "refId": "A"}]}]}