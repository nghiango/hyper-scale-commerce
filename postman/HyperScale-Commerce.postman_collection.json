        {
          "name": "Get Product Availability",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{appBaseUrl}}/catalog/products/{{productId}}/availability",
              "host": ["{{appBaseUrl}}"],
              "path": ["catalog", "products", "{{productId}}", "availability"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Orders (app :8080)",
      "item": [
        {
          "name": "Create Order (no idempotency key)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "if (json && json.id) pm.collectionVariables.set('orderId', json.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    { \"sku\": \"{{sku}}\", \"quantity\": 1 }\n  ]\n}"
            },
            "url": {
              "raw": "{{appBaseUrl}}/orders",
              "host": ["{{appBaseUrl}}"],
              "path": ["orders"]
            }
          },
          "response": []
        },
        {
          "name": "Create Order (fixed key — replay demo)",
          "description": "Send this twice with the same Idempotency-Key: the second call returns the cached 201 response instead of creating a duplicate order.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "console.log('Run this request again — same Idempotency-Key → replayed response, same orderId');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "demo-fixed-key-0001" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    { \"sku\": \"{{sku}}\", \"quantity\": 1 }\n  ]\n}"
            },
            "url": {
              "raw": "{{appBaseUrl}}/orders",
              "host": ["{{appBaseUrl}}"],
              "path": ["orders"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Order Query (read model :8081)",
      "item": [
        {
          "name": "List Orders",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{orderQueryBaseUrl}}/orders?page=0&size=20",
              "host": ["{{orderQueryBaseUrl}}"],
              "path": ["orders"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Order by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{orderQueryBaseUrl}}/orders/{{orderId}}",
              "host": ["{{orderQueryBaseUrl}}"],
              "path": ["orders", "{{orderId}}"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Admin (order-query :8081)",
      "item": [
        {
          "name": "Replay DLQ",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dlqTopic\": \"order-events.dlq\",\n  \"targetTopic\": \"order-events\",\n  \"maxRecords\": 100\n}"
            },
            "url": {
              "raw": "{{orderQueryBaseUrl}}/admin/dlq/replay",
              "host": ["{{orderQueryBaseUrl}}"],
              "path": ["admin", "dlq", "replay"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Observability",
      "item": [
